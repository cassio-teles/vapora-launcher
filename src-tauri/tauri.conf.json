{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapora",
  "version": "0.6.0",
  "identifier": "com.vapora.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vapora",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#0b1118",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https: http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "resources/aria2c.exe",
      "resources/ca-certificates.crt"
    ]
  }
}
